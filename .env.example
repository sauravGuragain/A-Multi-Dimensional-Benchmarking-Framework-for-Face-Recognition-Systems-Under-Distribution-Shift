# FaceEval-X API/dashboard settings.
#
# NOTE: nothing loads this file automatically. Either export the variables in
# the shell that starts the API (for example: export FACEEVAL_DB_PATH=/path/to/results.db)
# or rely on the defaults below, which work when the API is started from the
# repository root. start.sh passes through any of the FACEEVAL_* variables that are set.

# API server (api/dependencies.py). The API only reads these; it never writes.
FACEEVAL_DB_PATH=experiments/results.db
FACEEVAL_FIGURES_DIR=reports/figures
FACEEVAL_REPORTS_DIR=reports
FACEEVAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dashboard dev server (dashboard/vite.config.js) - where /api is proxied to.
# FACEEVAL_API_URL=http://127.0.0.1:8000

# Only if the API is served from a different origin than the dashboard
# (read at build/dev start by Vite). Leave unset to use the dev proxy.
# VITE_API_BASE=http://127.0.0.1:8000
