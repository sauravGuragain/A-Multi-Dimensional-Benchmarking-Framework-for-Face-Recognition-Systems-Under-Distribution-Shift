+def same_cell(v, s):
+    """JSON value v against the CSV text s written by csv.DictWriter (str(value); None and missing -> '')."""
+    if v is None:
+        return s == ""
+    if isinstance(v, float):
+        try:
+            f = float(s)
+        except ValueError:
+            return False
+        return (v != v and f != f) or f == v
+    return s == str(v)
+
